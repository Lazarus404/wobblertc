package wobblertc;

import type { Test } from std.testing;
import std.testing as T;
import { kbps } from wobblertc.Metrics;

let testKbps = fn(t: Test) {
  T.equal(t, kbps(8000i64, 1000i64), 64.0);
  T.equal(t, kbps(0i64, 1000i64), 0.0);
  T.equal(t, kbps(8000i64, 0i64), 0.0);
  T.equal(t, kbps(8000i64, -5i64), 0.0);
  null
};
