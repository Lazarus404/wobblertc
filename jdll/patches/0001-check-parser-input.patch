+/* Copies the next field of the line at *AT, up to END, into OUT of SIZE bytes; 0, or
+ * ICE_ERROR_MALFORMED when there is no field, or ICE_ERROR_TOO_LONG when it does not fit. */
+static int ice_candidate_field(const char** at, const char* end, char* out, size_t size) {
+  const char* s = *at;
+  while (s < end && (*s == ' ' || *s == '\t')) s++;
+  const char* start = s;
+  while (s < end && *s != ' ' && *s != '\t' && *s != '\r' && *s != '\n') s++;
+  if (s == start) return ICE_ERROR_MALFORMED;
+  if ((size_t)(s - start) >= size) return ICE_ERROR_TOO_LONG;
+  memcpy(out, start, s - start);
+  out[s - start] = '\0';
+  *at = s;
+  return 0;
+}
+
+/* Reads an unsigned decimal number of at most MAX from TEXT; 0, or ICE_ERROR_MALFORMED. */
+static int ice_candidate_number(const char* text, unsigned long max, unsigned long* value) {
+  char* rest = NULL;
+  if (text[0] < '0' || text[0] > '9') return ICE_ERROR_MALFORMED;
+  errno = 0;
+  *value = strtoul(text, &rest, 10);
+  return errno != 0 || *rest != '\0' || *value > max ? ICE_ERROR_MALFORMED : 0;
+}
