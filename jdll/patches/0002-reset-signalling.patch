From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jahred Love <jahred.love@aircall.io>
Date: Sat, 24 Oct 2026 19:53:39 +0100
Subject: [PATCH] Start each signalling session afresh, and say why one failed

What: libpeer keeps its one signalling session in a global that was
written over, not cleared: a second URL shorter than the first kept the
tail of the first, an empty token kept the last one, and
peer_signaling_disconnect neither forgot the session nor closed a
connection whose MQTT unsubscribe failed. Failures were not reported:
peer_signaling_connect always returned 0.

Now peer_signaling_connect ends any session before it and clears the
global, and returns 0 or a PEER_SIGNALING_ERROR_ code, leaving no session
behind when it fails: a bad URL, a server that cannot be reached, a
broker that refuses, or a WHIP endpoint that does not answer or whose
answer cannot be read. peer_signaling_disconnect always closes the
connection and forgets the session, and the new peer_signaling_abandon
does so without a word to the broker, for a caller that must not wait on
the network. peer_signaling_loop does nothing without a connection.

Why: wobblertc signals more than once in a process, at different URLs,
and must report to Jello why signalling failed.

This patch applies after 0001.

Like libpeer, this patch is under the MIT licence.
---
 src/peer_signaling.c | 95 ++++++++++++++++++++++++++++++--------------
 src/peer_signaling.h | 15 ++++++-
 2 files changed, 79 insertions(+), 31 deletions(-)

diff --git a/src/peer_signaling.c b/src/peer_signaling.c
index a197347..a443acf 100644
--- a/src/peer_signaling.c
+++ b/src/peer_signaling.c
@@ -61,6 +61,13 @@ typedef struct PeerSignaling {
 
   PeerConnection* pc;
 
+  /* Whether a session was started and not yet ended, and whether its MQTT connection, with its
+   * TLS session and socket, is open. */
+  int active;
+  int connected;
+  /* Why the last WHIP post failed, a PEER_SIGNALING_ERROR_ code, or 0. */
+  int error;
+
 } PeerSignaling;
 
 static PeerSignaling g_ps = {0};
@@ -337,7 +344,7 @@ static int peer_signaling_http_post(const char* hostname, const char* path, int
 
   if (ret < 0) {
     LOGE("Failed to connect to %s:%d", hostname, port);
-    return ret;
+    return PEER_SIGNALING_ERROR_CONNECT;
   }
 
   res = peer_signaling_http_request(&trans_if, "POST", 4, hostname, strlen(hostname), path,
@@ -347,12 +354,12 @@ static int peer_signaling_http_post(const char* hostname, const char* path, int
 
   if (res.pHeaders == NULL) {
     LOGE("Response headers are NULL");
-    return -1;
+    return PEER_SIGNALING_ERROR_REFUSED;
   }
 
   if (res.pBody == NULL) {
     LOGE("Response body is NULL");
-    return -1;
+    return PEER_SIGNALING_ERROR_REFUSED;
   }
 
   LOGI(
@@ -360,20 +367,23 @@ static int peer_signaling_http_post(const char* hostname, const char* path, int
       "Response Headers: %s\nResponse Status: %u\nResponse Body: %s\n",
       hostname, path, res.pHeaders, res.statusCode, res.pBody);
 
-  if (res.statusCode == 201) {
-    /* The body lies in the response buffer, not ended by a zero byte. */
-    char* answer = malloc(res.bodyLen + 1);
-    if (answer == NULL) {
-      return -1;
-    }
-    memcpy(answer, res.pBody, res.bodyLen);
-    answer[res.bodyLen] = '\0';
-    ret = peer_connection_set_remote_description(g_ps.pc, answer, SDP_TYPE_ANSWER);
-    free(answer);
-    if (ret != 0) {
-      LOGE("Cannot read the answer");
-      return -1;
-    }
+  if (res.statusCode != 201) {
+    LOGE("The WHIP endpoint did not answer");
+    return PEER_SIGNALING_ERROR_REFUSED;
+  }
+
+  /* The body lies in the response buffer, not ended by a zero byte. */
+  char* answer = malloc(res.bodyLen + 1);
+  if (answer == NULL) {
+    return PEER_SIGNALING_ERROR_ANSWER;
+  }
+  memcpy(answer, res.pBody, res.bodyLen);
+  answer[res.bodyLen] = '\0';
+  ret = peer_connection_set_remote_description(g_ps.pc, answer, SDP_TYPE_ANSWER);
+  free(answer);
+  if (ret != 0) {
+    LOGE("Cannot read the answer");
+    return PEER_SIGNALING_ERROR_ANSWER;
   }
   return 0;
 }
@@ -428,8 +438,9 @@ static int peer_signaling_mqtt_connect(const char* hostname, int port) {
 
   if (ssl_transport_connect(&g_ps.net_ctx, hostname, port, NULL) < 0) {
     LOGE("ssl transport connect failed");
-    return -1;
+    return PEER_SIGNALING_ERROR_CONNECT;
   }
+  g_ps.connected = 1;
 
   g_ps.transport.recv = ssl_transport_recv;
   g_ps.transport.send = ssl_transport_send;
@@ -463,7 +474,7 @@ static int peer_signaling_mqtt_connect(const char* hostname, int port) {
 
   if (status != MQTTSuccess) {
     LOGE("MQTT_Connect failed: Status=%s.", MQTT_Status_strerror(status));
-    return -1;
+    return PEER_SIGNALING_ERROR_REFUSED;
   }
 
   LOGI("MQTT_Connect succeeded.");
@@ -505,6 +516,9 @@ static int peer_signaling_mqtt_subscribe(int subscribed) {
 static void peer_signaling_onicecandidate(char* description, void* userdata) {
   cJSON* res;
   char* payload;
+  if (!g_ps.active) {
+    return;
+  }
   if (g_ps.id > 0) {
     res = cJSON_CreateObject();
     cJSON_AddStringToObject(res, "jsonrpc", RPC_VERSION);
@@ -522,9 +536,9 @@ static void peer_signaling_onicecandidate(char* description, void* userdata) {
       char cred[TOKEN_MAX_LEN + 10];
       memset(cred, 0, sizeof(cred));
       snprintf(cred, sizeof(cred), "Bearer %s", g_ps.token);
-      peer_signaling_http_post(g_ps.host, g_ps.path, g_ps.port, cred, description);
+      g_ps.error = peer_signaling_http_post(g_ps.host, g_ps.path, g_ps.port, cred, description);
     } else {
-      peer_signaling_http_post(g_ps.host, g_ps.path, g_ps.port, "", description);
+      g_ps.error = peer_signaling_http_post(g_ps.host, g_ps.path, g_ps.port, "", description);
     }
   }
 }
@@ -537,24 +551,33 @@ int peer_signaling_connect(const char* url, const char* token, PeerConnection* p
   int proto;
 
   /* Everything is checked against the fields it goes into before any is written. */
+  int ret = 0;
+
   if ((proto = peer_signaling_resolve_url(url, host, &port, path)) < 0) {
     LOGE("Resolve URL failed");
-    return -1;
+    return PEER_SIGNALING_ERROR_URL;
   }
 
   if (token && strlen(token) >= sizeof(g_ps.token)) {
     LOGE("Token too long");
-    return -1;
+    return PEER_SIGNALING_ERROR_URL;
   }
 
   if (proto == 0) {
     client_id = strrchr(path, '/');
     if (client_id == NULL || client_id[1] == '\0' || strlen(client_id + 1) >= sizeof(g_ps.client_id)) {
       LOGE("Invalid MQTT client identifier");
-      return -1;
+      return PEER_SIGNALING_ERROR_URL;
     }
   }
 
+  /* A new session starts from nothing: nothing of the last one's URL, token or connection is
+   * kept. */
+  if (g_ps.active) {
+    peer_signaling_disconnect();
+  }
+  memset(&g_ps, 0, sizeof(g_ps));
+  g_ps.active = 1;
   g_ps.proto = proto;
   g_ps.port = port;
   memcpy(g_ps.host, host, sizeof(g_ps.host));
@@ -572,35 +595,49 @@ int peer_signaling_connect(const char* url, const char* token, PeerConnection* p
       snprintf(g_ps.client_id, sizeof(g_ps.client_id), "%s", client_id + 1);
       snprintf(g_ps.subtopic, sizeof(g_ps.subtopic), "%s/invoke", g_ps.path);
       snprintf(g_ps.pubtopic, sizeof(g_ps.pubtopic), "%s/result", g_ps.path);
-      if (peer_signaling_mqtt_connect(g_ps.host, g_ps.port) == 0) {
-        peer_signaling_mqtt_subscribe(1);
+      if ((ret = peer_signaling_mqtt_connect(g_ps.host, g_ps.port)) == 0 &&
+          peer_signaling_mqtt_subscribe(1) != 0) {
+        ret = PEER_SIGNALING_ERROR_REFUSED;
       }
     } break;
     case 1: {  // HTTP
       peer_connection_create_offer(g_ps.pc);
+      ret = g_ps.error;
     } break;
     default: {
     } break;
   }
 
-  return 0;
+  if (ret != 0) {
+    peer_signaling_abandon();
+  }
+  return ret;
 }
 
 void peer_signaling_disconnect() {
   MQTTStatus_t status = MQTTSuccess;
 
-  if (!g_ps.proto && !peer_signaling_mqtt_subscribe(0)) {
+  if (g_ps.connected && peer_signaling_mqtt_subscribe(0) == 0) {
     status = MQTT_Disconnect(&g_ps.mqtt_ctx);
     if (status != MQTTSuccess) {
       LOGE("Failed to disconnect with broker: %s", MQTT_Status_strerror(status));
     }
+  }
+  peer_signaling_abandon();
+  LOGI("Disconnected");
+}
 
+void peer_signaling_abandon() {
+  if (g_ps.connected) {
     ssl_transport_disconnect(&g_ps.net_ctx);
   }
-  LOGI("Disconnected");
+  memset(&g_ps, 0, sizeof(g_ps));
 }
 
 int peer_signaling_loop() {
+  if (!g_ps.connected) {
+    return -1;
+  }
   MQTT_ProcessLoop(&g_ps.mqtt_ctx);
   return 0;
 }
diff --git a/src/peer_signaling.h b/src/peer_signaling.h
index 7a51f79..dfcc792 100644
--- a/src/peer_signaling.h
+++ b/src/peer_signaling.h
@@ -9,12 +9,23 @@ extern "C" {
 
 #ifndef DISABLE_PEER_SIGNALING
 
-/* Signals for PC at URL, with TOKEN or NULL; 0, or -1 for a URL or token that is malformed or
- * longer than libpeer keeps, with nothing changed. */
+/* Why signalling failed. */
+#define PEER_SIGNALING_ERROR_URL -1      /* a URL or token that is malformed or too long */
+#define PEER_SIGNALING_ERROR_CONNECT -2  /* the server could not be reached */
+#define PEER_SIGNALING_ERROR_REFUSED -6  /* the server refused, or a WHIP endpoint did not answer */
+#define PEER_SIGNALING_ERROR_ANSWER -7   /* a WHIP endpoint's answer could not be read */
+
+/* Signals for PC at URL, with TOKEN or NULL: one session a process, which starts afresh, ending
+ * any before it. For WHIP, posts PC's offer and takes the answer; for MQTT, connects to the broker
+ * and subscribes. 0, or a PEER_SIGNALING_ERROR_ code, with no session left behind. */
 int peer_signaling_connect(const char* url, const char* token, PeerConnection* pc);
 
+/* Ends the session, leaving the MQTT broker politely, and forgets it, so that another can start. */
 void peer_signaling_disconnect();
 
+/* Ends the session without a word to the broker, closing its connection, and forgets it. */
+void peer_signaling_abandon();
+
 int peer_signaling_loop();
 
 #endif  // DISABLE_PEER_SIGNALING
